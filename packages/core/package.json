{
  "name": "@screech/core",
  "version": "0.0.0",
  "private": true,
  "description": "Core TypeScript library for Screech",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22",
    "fast-check": "3.22.0",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
